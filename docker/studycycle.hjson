{
  # for more info about the config, check out the documentation
  # https://join-lemmy.org/docs/en/administration/configuration.html

  # This is a minimal studycycle config for the dev / main branch. Do not use for a 
  # release / stable version.

  setup: {
    admin_username: "studycycle"
    admin_password: "studycyclestudycycle"
    site_name: "studycycle-dev"
  }
  database: {
    connection: "postgres://studycycle:password@postgres:5432/studycycle"
  }

  hostname: "localhost"
  bind: "0.0.0.0"
  port: 8536

  pictrs: {
    url: "http://pictrs:8080/"
    api_key: "my-pictrs-key"
  }

  #opentelemetry_url: "http://otel:4137"
}
